# MySQL 数据库密码（必须和 docker-compose.yml 中的 MYSQL_ROOT_PASSWORD 一致）
MYSQL_ROOT_PASSWORD=123456

# AI 大模型配置（暂时用不到，可以留空）
AI_API_KEY=sk-placeholder-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 数据库连接地址（使用 localhost，因为 MySQL 在树莓派本地）
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/justword

# JWT 密钥（用于用户认证，生成一个随机字符串）
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT 算法
ALGORITHM=HS256

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用环境
ENVIRONMENT=development
DEBUG=true
PORT=3000